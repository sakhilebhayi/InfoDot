# Meilisearch data (not used; search uses the database and Scout tntsearch)
/data.ms/

# PHPUnit result cache: rewritten on every run
/.phpunit.cache/

# TNTSearch index files are runtime state the host owns; a tracked copy would be forced over the live index by deploy's git reset --hard.
/storage/*.index
/storage/oauth-*.key
