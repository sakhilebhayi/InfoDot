APP_NAME=InfoDot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infodot
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_CONNECTION=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Expiry-warning emails for Dot Points (php artisan points:deliver-expiry-warnings, hourly) need a REAL mailer:
# with MAIL_MAILER=log or array nothing is sent and the warnings stay pending in Dot.Dopemine.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@infodot.app
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

REVERB_APP_ID=infodot
REVERB_APP_KEY=infodot-key
REVERB_APP_SECRET=infodot-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

SCOUT_DRIVER=tntsearch

# Ecosystem Platform URLs
# Platform URLs default to the live https://<name>.infodot.co.za hosts in
# config/ecosystem.php; set DOT_<NAME>_URL only to point somewhere else. Do NOT
# copy the old https://<name>.infodot.app values back: that domain is
# unregistered, and the SSO handoff only sends tokens to ECOSYSTEM_TRUSTED_DOMAINS.
ECOSYSTEM_TRUSTED_DOMAINS=infodot.co.za
ECOSYSTEM_HANDOFF_TTL=5

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Dot Points (Dot.Dopemine hosts the ledger): same value as DOPEMINE_INGEST_SECRET_INFODOT there. Unset = events wait in the outbox.
DOPEMINE_URL=https://dopemine.infodot.co.za
DOPEMINE_INGEST_SECRET=
